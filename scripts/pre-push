#!/bin/sh
echo "→ Running pre-push checks..."

echo "  [1/3] ruff lint"
uv run ruff check src/ tests/ || { echo "✗ ruff lint failed"; exit 1; }

echo "  [2/3] ruff format"
uv run ruff format --check src/ tests/ || { echo "✗ ruff format failed"; exit 1; }

echo "  [3/3] pytest"
uv run pytest -q || { echo "✗ tests failed"; exit 1; }

echo "✓ All checks passed"
